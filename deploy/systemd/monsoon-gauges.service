[Unit]
Description=Monsoon Ears — stream/rain gauge feed (USGS + optional Pima ALERT)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=keaton
WorkingDirectory=/home/keaton/Documents/projects/monsoon_ears
EnvironmentFile=/home/keaton/Documents/projects/monsoon_ears/.env
ExecStart=/home/keaton/.local/bin/uv run --no-sync python -m ingestion.runner_gauges
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
