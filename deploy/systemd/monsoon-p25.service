[Unit]
# P25/PCWIN ingestion. NOT enabled by install_services.sh, and NOT meant to run
# alongside monsoon-sdr — the supervisor owns the dongle and launches the P25 leg
# itself (gated by SDR_ENABLE_P25 in .env). Kept for manual/debug runs of the
# P25 path in isolation. op25 must be built + locking PCWIN first (see
# deploy/op25_setup.md).
Description=Monsoon Ears — P25/PCWIN ingestion (op25 -> Whisper -> SQLite)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=keaton
WorkingDirectory=/home/keaton/Documents/projects/monsoon_ears
EnvironmentFile=/home/keaton/Documents/projects/monsoon_ears/.env
# Requires P25_WAV_DIR (and optionally OP25_CMD) in .env.
ExecStart=/home/keaton/.local/bin/uv run --no-sync python -m ingestion.runner_p25
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
