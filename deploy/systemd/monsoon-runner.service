[Unit]
Description=Monsoon Ears — analog FM ingestion (scanner -> VAD -> Whisper -> SQLite)
After=network-online.target
Wants=network-online.target
# The RTL-SDR can take a moment to settle after a USB reset; give the service
# room to retry rather than tripping the start limit and giving up.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=keaton
WorkingDirectory=/home/keaton/Documents/projects/monsoon_ears
EnvironmentFile=/home/keaton/Documents/projects/monsoon_ears/.env
ExecStart=/home/keaton/.local/bin/uv run --no-sync python -m ingestion.runner_analog
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
