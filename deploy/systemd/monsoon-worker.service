[Unit]
Description=Monsoon Ears — agent worker (classify -> extract -> alert + monsoon digest)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=keaton
WorkingDirectory=/home/keaton/Documents/projects/monsoon_ears
EnvironmentFile=/home/keaton/Documents/projects/monsoon_ears/.env
ExecStart=/home/keaton/.local/bin/uv run --no-sync python -m agents.worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
