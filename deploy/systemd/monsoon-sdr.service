[Unit]
# SDR supervisor — the single owner of the one RTL-SDR. It time-shares the RF
# legs (analog scanner vs. op25/P25); running it means NOT running
# monsoon-runner or monsoon-p25 directly (they'd fight for the device). The
# supervisor launches those runners itself, one at a time. See
# ingestion/sdr_supervisor.py and deploy/op25_setup.md.
Description=Monsoon Ears — SDR supervisor (time-shares the dongle: analog <-> P25)
After=network-online.target
Wants=network-online.target
# The RTL-SDR can take a moment to settle after a USB reset; give the service
# room to retry rather than tripping the start limit and giving up.
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=keaton
WorkingDirectory=/home/keaton/Documents/projects/monsoon_ears
EnvironmentFile=/home/keaton/Documents/projects/monsoon_ears/.env
ExecStart=/home/keaton/.local/bin/uv run --no-sync python -m ingestion.sdr_supervisor
# The supervisor kills its child leg on SIGTERM; give the whole tree time to
# release the SDR before systemd escalates to SIGKILL.
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
