[Unit]
Description=Monsoon Ears — Streamlit dashboard (UI on :8501)
After=network-online.target monsoon-api.service
Wants=network-online.target monsoon-api.service
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=keaton
WorkingDirectory=/home/keaton/Documents/projects/monsoon_ears
EnvironmentFile=/home/keaton/Documents/projects/monsoon_ears/.env
# Wraps scripts/run_dashboard.sh, which honors DASHBOARD_PORT/MONSOON_API_URL
# from .env and binds 0.0.0.0. The dashboard tolerates the API being briefly
# unavailable (each tab catches API errors), so a soft Wants= on monsoon-api is
# enough — no hard ordering guarantee needed.
ExecStart=/home/keaton/Documents/projects/monsoon_ears/scripts/run_dashboard.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
