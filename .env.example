# SDR
SDR_SAMPLE_RATE=1024000
SDR_GAIN=40

# Whisper
WHISPER_MODEL=small

# Capture / squelch
CHUNK_DURATION_SEC=8
SILENCE_THRESHOLD=0.01
SILENCE_MIN_DURATION=1.5

# Storage
DB_PATH=./data/events.db

# APRS (Phase 02: skeleton only; flip to true once 2nd dongle is attached)
APRS_ENABLED=false

# Logging
LOG_LEVEL=INFO
