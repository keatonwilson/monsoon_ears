# SDR
SDR_SAMPLE_RATE=1024000
SDR_GAIN=40

# Whisper. WHISPER_BACKEND selects the decode engine:
#   openai  — reference openai-whisper (PyTorch). Default; `small` is the Pi sweet spot.
#   faster  — faster-whisper (CTranslate2). 3-4x quicker on the Pi 5 CPU at int8,
#             which makes `medium` feasible inline. Benchmark with
#             scripts/benchmark_whisper.py before flipping. Same model names.
# WHISPER_COMPUTE_TYPE / WHISPER_DEVICE / WHISPER_BEAM_SIZE apply to `faster` only.
WHISPER_BACKEND=openai
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_BEAM_SIZE=5
# Hallucination gates (ingestion/transcribe.py). Whisper emits ghost text on
# silence/noise; these drop it. Tunable here so the Pi can be adjusted without a
# code change. Defaults match OpenAI's reference values; LOGPROB_DROP is ours.
#   NO_SPEECH_THRESHOLD       — silence gate fires above this (paired w/ logprob)
#   LOGPROB_THRESHOLD         — paired confidence floor for the silence gate
#   LOGPROB_DROP_THRESHOLD    — standalone low-confidence drop (stricter)
#   COMPRESSION_RATIO_THRESHOLD — repetitive-babble gate
NO_SPEECH_THRESHOLD=0.6
LOGPROB_THRESHOLD=-1.0
LOGPROB_DROP_THRESHOLD=-1.2
COMPRESSION_RATIO_THRESHOLD=2.4

# Capture / squelch
CHUNK_DURATION_SEC=15
# Post-demod RMS threshold. Audio RMS BELOW this = signal present (PASS).
# Audio RMS ABOVE this = FM noise floor (SQUELCH). Empirical on R820T + AGC:
# NOAA carrier ≈ 0.27, idle noise floor ≈ 0.85, so 0.65 splits cleanly.
NOISE_FLOOR_RMS=0.65

# Voice Activity Detection (webrtcvad). 0=least aggressive about flagging
# non-speech, 3=most aggressive. 2 is a good middle for noisy radio audio.
VAD_AGGRESSIVENESS=2
# Drop VAD segments shorter than this — filters key-up blips and false positives.
# Bumped from 800 to 1500: brief one-syllable bursts ("yeah", "copy") aren't
# usefully transcribable on their own and just create noise in the feed.
VAD_MIN_SEGMENT_MS=1500

# --- Scanner (multi-frequency activity-hold) ---
# Listen this long on each freq before deciding signal present.
SCAN_PROBE_SEC=1.0
# Consecutive squelched chunks before ending HOLD and resuming scan.
# Bumped from 1 to 2 so a brief inter-turn pause inside a back-and-forth
# dispatch doesn't release the scanner mid-conversation.
SCAN_HANGOVER_CHUNKS=2
# Hard cap on time held on one freq — prevents stuck-carrier deadlock.
SCAN_MAX_HOLD_SEC=120
# Filter the scan list by priority floor: primary | high | medium | low.
SCAN_MIN_PRIORITY=high

# NOAA Weather Radio is excluded from the rolling scan (always-on signal would
# dominate). Instead the scanner visits it periodically for forecast context.
NOAA_FREQ_MHZ=162.3975
NOAA_VISIT_INTERVAL_MIN=15
# Bumped from 30 to 60 so each visit captures a coherent ~60s chunk of the
# continuous broadcast (the NOAA loop is a few minutes long).
NOAA_VISIT_DURATION_SEC=60

# Storage
DB_PATH=./data/events.db

# --- Agents (Phase 03) ---
ANTHROPIC_API_KEY=sk-ant-CHANGE-ME
CLASSIFY_MODEL=claude-haiku-4-5-20251001
EXTRACT_MODEL=claude-haiku-4-5-20251001
DIGEST_MODEL=claude-sonnet-4-6
DIGEST_INTERVAL_MIN=15
WORKER_POLL_SEC=5

# Ntfy push topic — pick a random hard-to-guess string. Install the Ntfy app
# on your phone and subscribe to https://ntfy.sh/<your-topic>.
NTFY_TOPIC=monsoon-ears-CHANGE-ME
NTFY_BASE_URL=https://ntfy.sh

# APRS-IS — internet feed of APRS packets; no 2nd dongle needed.
# Filter `r/lat/lon/km` = circular radius around a point.
# Set APRS_IS_CALLSIGN to your own licensed callsign to be a good APRS-IS citizen
# (anonymous N0CALL clients may be filtered). Leave APRS_IS_PASSCODE=-1 to stay
# receive-only — that identifies you without granting packet-injection rights.
# Only set a real verified passcode if you ever need to transmit (we never do).
APRS_IS_ENABLED=false
APRS_IS_CALLSIGN=N0CALL
APRS_IS_PASSCODE=-1
APRS_IS_FILTER=r/32.2/-110.9/50
APRS_IS_SERVER=rotate.aprs.net

# Geocoding. The public Nominatim service 403s placeholder / contact-less user
# agents — use a REAL identifier (a contact URL or email) or geocoding silently
# returns no coordinates (the map stays empty). Providers are tried in order;
# arcgis + census are keyless fallbacks so one provider's 403/outage doesn't
# blank out all geocoding.
GEOCODE_CACHE_PATH=./data/geocode_cache.json
NOMINATIM_USER_AGENT=monsoon-ears/1.0 (+https://github.com/keatonwilson/monsoon_ears)
GEOCODER_CHAIN=nominatim,arcgis,census
# Only geocode locations from a transmission classified at/above this confidence
# (garbled audio gets low confidence; its "locations" are noise).
MIN_GEOCODE_CONFIDENCE=0.5
# A clean no-match is cached this long before being re-queried (default 30d), so
# a later provider/data improvement can resolve it. Hits are cached forever;
# provider errors are never cached (a transient outage must not poison the cache).
GEOCODE_MISS_TTL_SEC=2592000

# Monsoon digest structured-output budget. 1024 truncated ~21% of digests once
# gauges were folded in (instructor IncompleteOutputException); 2048 is safe.
DIGEST_MAX_TOKENS=2048

# P25 / PCWIN (op25). Only used by ingestion.runner_p25; requires op25 built on
# the Pi — see deploy/op25_setup.md. P25_WAV_DIR is where op25 writes per-call
# WAVs (named <talkgroup_dec>-<epoch_ms>.wav). Leave OP25_CMD empty to run op25
# as its own process/service; set it to have the runner launch op25 itself.
P25_WAV_DIR=./data/op25_calls
P25_POLL_SEC=1.0
OP25_CMD=

# SDR supervisor (ingestion.sdr_supervisor) — the single owner of the one
# dongle. It time-shares the RF legs (analog scanner vs. op25/P25), since only
# one can hold the SDR at a time. Each cycle the Band Manager assigns dwell time.
#
# Which legs may run. With both on, the supervisor time-shares the dongle and op25
# pays a ~20s control-channel re-lock each time the P25 leg starts (calls missed in
# that window). Set SDR_ENABLE_ANALOG=false for a P25-only posture: op25 then holds
# the dongle continuously and re-locks just once at startup (see op25_setup.md §6).
SDR_ENABLE_ANALOG=true
SDR_ENABLE_P25=false
# Posture when nothing special is happening: p25 | balanced | analog. Seeds the
# default split; the explicit weights below override it if set.
SDR_DEFAULT_POSTURE=p25
SDR_P25_WEIGHT=0.7
SDR_ANALOG_WEIGHT=0.3
# Length of one full split, and the minimum any single leg gets within it.
SDR_CYCLE_MIN=10
SDR_LEG_FLOOR_SEC=60
# Pause between killing one leg and starting the next, so the SDR fully releases.
SDR_LEG_COOLDOWN_SEC=3
SDR_TERM_GRACE_SEC=10
SDR_POLL_TICK_SEC=2
# Watchdog: if this many legs in a row exit before their dwell deadline (i.e.
# nothing can hold the SDR), the supervisor exits non-zero so systemd restarts
# it and re-initializes the dongle, instead of sitting "active" but wedged.
SDR_MAX_LEG_FAILURES=5
# Agentic optimizer: when true, a cheap LLM re-weights the split from live
# conditions (rising gauges, recent flood traffic, season). Off = pure rules.
BAND_MANAGER_AGENT=false
BAND_MANAGER_MODEL=claude-haiku-4-5-20251001
# Status the supervisor writes for the dashboard (current leg + rationale).
SDR_STATUS_FILE=./data/sdr_status.json

# Stream/rain gauges (ingestion.runner_gauges). USGS is always on (site list is
# in config/gauges.py). Pima County ALERT is best-effort and off by default —
# its public endpoint is undocumented and may break (see ingestion/pima_alert_client.py).
GAUGE_POLL_MIN=15
PIMA_ALERT_ENABLED=false

# NWS active watches/warnings (api.weather.gov) — polled by the gauge runner.
# `point` resolves the containing zones; NWS requires a contact-ful User-Agent.
NWS_ENABLED=true
NWS_POINT=32.2,-110.97
NWS_USER_AGENT=monsoon-ears/1.0 (+https://github.com/keatonwilson/monsoon_ears)

# Logging
LOG_LEVEL=INFO
